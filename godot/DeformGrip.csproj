<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      Toggle this to false once Role 2b delivers core/*.csproj:
        1. Set <UseCoreStub>false</UseCoreStub>
        2. Update the ProjectReference below to Role 2b's exact .csproj filename
        3. Adjust RealDeformCore in Scripts/Core/CoreAdapter.cs if namespace/method signatures differ
    -->
    <UseCoreStub>true</UseCoreStub>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseCoreStub)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_CORE_STUB</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCoreStub)' != 'true'">
    <!-- Exclude dev stub code when building against Role 2b's real core library -->
    <Compile Remove="_dev_stubs\**\*.cs" />
    <!-- Example reference once Role 2b commits core/*.csproj:
    <ProjectReference Include="..\core\DeformGrip.Core.csproj" />
    -->
  </ItemGroup>
</Project>
