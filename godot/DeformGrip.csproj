<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      false: build against Role 2b's real core library (core/DeformGrip.Core.csproj).
      true:  build against the throw-away stub in _dev_stubs/ (no G.bin needed; development only).
    -->
    <UseCoreStub>false</UseCoreStub>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseCoreStub)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_CORE_STUB</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCoreStub)' != 'true'">
    <!-- Real core: exclude the dev stub and reference the core library -->
    <Compile Remove="_dev_stubs\**\*.cs" />
    <ProjectReference Include="..\core\DeformGrip.Core.csproj" />
  </ItemGroup>
</Project>
